# Local peer authentication (Ubuntu/WSL). Change the role to your local role.
PGHOST=/var/run/postgresql
PGPORT=5432
PGUSER=jc
PGDATABASE=odin_mini_message_board
# For local TCP/password login, set PGHOST=localhost and enter PGPASSWORD privately.
# PGPASSWORD=replace_with_your_local_password
PORT=3000

# Hosted connection: use DATABASE_URL instead of the PG* settings above.
# Replace placeholders privately; TLS certificate verification is always enforced.
# DATABASE_URL=postgresql://ROLE:PASSWORD@HOST/DATABASE?sslmode=verify-full
